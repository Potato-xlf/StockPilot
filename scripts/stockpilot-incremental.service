[Unit]
Description=StockPilot incremental A-share market data sync
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/stockpilot/repo
ExecStart=/usr/bin/docker compose --env-file .env.vps -f docker-compose.vps.yml run --rm --no-deps api stockpilot sync-incremental --lookback-days 5
TimeoutStartSec=6h
Nice=10
CPUWeight=10
IOSchedulingClass=idle
IOSchedulingPriority=7
